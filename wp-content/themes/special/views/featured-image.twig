<figure class="hero{{ post.meta('toggle_image_filter') ? ' no-filter' : '' }}">
  <img
    srcset="
        {{ post.thumbnail.src
      |resize(1594)
      |towebp }} 1594w,
        {{ post.thumbnail.src
      |resize(1410)
      |towebp }} 1410w,
        {{ post.thumbnail.src
      |resize(1200)
      |towebp }} 1200w,
        {{ post.thumbnail.src
      |resize(1080)
      |towebp }} 1080w,
        {{ post.thumbnail.src
      |resize(721)
      |towebp }}   721w,
        {{ post.thumbnail.src
      |resize(600)
      |towebp }}   600w,
        {{ post.thumbnail.src
      |resize(300)
      |towebp }}   300w
      "
    sizes="(min-width: 135em) 837px, (min-width: 48em) 40vw, calc(100vw - 20px)"
    src="{{ post.thumbnail.src|resize(1200)|towebp }}"
    alt="{{ post.thumbnail.alt }}"
    width="{{ post.thumbnail.width }}"
    height="{{ post.thumbnail.height }}"
  />
</figure>
