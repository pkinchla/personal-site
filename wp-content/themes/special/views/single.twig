{% extends 'base.twig' %}

{% block content %}
  <article class="grid post-type-{{ post.post_type }}" id="post-{{ post.ID }}">
    <header class="surface shadow-long">
      <h1>{{ post.title }}</h1>
      {% include 'byline.twig' %}
    </header>
    {% if post.thumbnail %}
      {% include 'featured-image.twig' %}
    {% endif %}
    <div class="page-content">
      {{ post.content }}
      <a href="/random/" class="random-link">
        ⚘<span class="assistive-text">Random Post</span>
      </a>
      <footer class="entry-footer sans-regular-italic surface">
        {{ function('special_entry_footer') }}
      </footer>
      {{ post.post_nav }}
      {{ function('comments_template') }}
    </div>
  </article>
{% endblock %}
