{% extends 'base.twig' %}

{% block content %}
  <article class="grid" id="post-{{ post.ID }}">
    <header>
      <h1>{{ post.title }}</h1>
      {% include 'byline-page.twig' %}
    </header>
    {% if post.thumbnail %}
      {% include 'featured-image.twig' %}
    {% endif %}
    <div class="page-content">
      {{ post.content }}
    </div>
  </article>
{% endblock %}
