{% extends 'base.twig' %}

{% block content %}
  <article class="grid">
    {% if posts is empty %}
      <header class="surface shadow-long">
        <h1>No Results</h1>
      </header>
      <figure class="hero">
        <img
          src="{{ theme.path }}/images/cham.jpg"
          alt="close up of miniature metallic chameleon standing on a metallic pedestal"
          width="1300"
          height="635"
        />
      </figure>
      <div class="page-content">
        <p>
          Sorry, no results matched your query, maybe try again
        </p>
        {% include 'searchform.twig' %}
      </div>
    {% else %}
      <header class="surface shadow-long">
        <h1>{{ title }}</h1>
      </header>
      <figure class="hero">
        <img
          src="{{ theme.path }}/images/cham.jpg"
          alt="close up of miniature metallic chameleon standing on a metallic pedestal"
          width="1300"
          height="635"
        />
      </figure>
      <div class="page-content">
        <h2 class="assistive-text">Results</h2>
        {% for post in posts %}
          <article class="mb-2">
            {% include ['card.twig'] %}
          </article>
        {% endfor %}
        {% include 'pagination.twig' %}
      </div>
    {% endif %}
  </article>
{% endblock %}
