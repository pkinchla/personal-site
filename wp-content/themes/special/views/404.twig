{% extends 'base.twig' %}

{% block content %}
  <article class="grid">
    <header class="surface shadow-long">
      <h1>404 <br />Not found</h1>
    </header>
    <figure class="hero">
      <picture>
        <source
          srcset="{{ theme.path }}/images/max-still.jpg"
          media="(prefers-reduced-motion: reduce)"
        />
        <img
          src="{{ theme.path }}/images/max.gif"
          alt="max headroom animated gif gesturing towards camera"
          width="500"
          height="290"
        />
      </picture>
    </figure>
    <div class="page-content">
      {% if bot_was_redirected %}
        <p>
          You are seeing this page because you may be a bot who attempted to
          exploit the common <code>/xmlrpc.php</code> vulnerability in WordPress.
          If this is not the case, my apologies.
        </p>
      {% else %}
        <p>
          Sorry, we couldn't find what you're looking for. Maybe try a search?
        </p>
        {% include 'searchform.twig' %}
      {% endif %}
    </div>
  </article>
{% endblock %}
